<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>portix</AssemblyName>
    <!-- Only takes effect for an actual -p:PublishSingleFile=true publish; a no-op for ordinary
         dotnet build/run. Makes that kind of publish bundle appsettings.json into the single exe
         instead of leaving it as a loose file alongside it. wwwroot is handled separately below
         (as an EmbeddedResource) — IncludeAllContentForSelfExtract alone does not make ASP.NET
         Core's own WebRootPath resolution find self-extracted content; confirmed by direct testing,
         not assumed. -->
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Portix.Shared\Portix.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.10" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.10" />
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <!-- Compiled into the assembly instead of served from a physical wwwroot folder, so the
       dashboard's static assets work identically whether this runs as a normal multi-file build
       or a single-file publish with nothing else alongside it (see Program.cs's UseStaticFiles). -->
  <ItemGroup>
    <Content Remove="wwwroot\**" />
    <EmbeddedResource Include="wwwroot\**" />
  </ItemGroup>

  <!-- Same problem as wwwroot above, same fix: confirmed by direct testing that a standalone
       single-file exe (nothing else alongside it — exactly how a GitHub Release asset ships)
       cannot find appsettings.json via IncludeAllContentForSelfExtract/self-extraction, so
       Program.cs's config ends up empty and silently falls back to hardcoded defaults. Kept as a
       Content item too (not removed) so `dotnet publish`'s loose copy and local `dotnet run`
       keep working exactly as before; this just adds a reliable fallback source read from the
       assembly's own embedded resources. -->
  <ItemGroup>
    <EmbeddedResource Include="appsettings.json" />
  </ItemGroup>

</Project>
